# Copy to .env.test for the end-to-end tests (npm run test:e2e). See TESTING.md.
# Use a SEPARATE Supabase project for tests: the tests create, activate, close
# and delete surveys, and activating closes whatever survey is active.

# Test project: Project Settings -> API (public/publishable key only)
VITE_SUPABASE_URL=https://your-test-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-test-project-public-key

# A user created in the TEST project (Authentication -> Users -> Add user)
E2E_EMAIL=test-instructor@example.com
E2E_PASSWORD=choose-a-password
